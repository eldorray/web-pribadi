<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive Laravel/project files when the whole
    # project is uploaded into a cPanel document root.
    <FilesMatch "(^\.|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|artisan|phpunit\.xml)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Send every web request to Laravel's public directory.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
